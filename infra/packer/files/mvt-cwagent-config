#!/usr/bin/env bash
# Point the CloudWatch agent at the log group named in /etc/mvt/config.yaml.
set -euo pipefail
# A YAML parser, not a pattern: Terraform's yamlencode quotes the keys, CloudFormation
# does not.
group=$(/opt/mvt/bin/python -c '
import yaml
print((yaml.safe_load(open("/etc/mvt/config.yaml")) or {}).get("log_group") or "")')
[ -n "$group" ] || exit 0
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<JSON
{
  "agent": {"run_as_user": "cwagent"},
  "logs": {"logs_collected": {"files": {"collect_list": [
    {"file_path": "/var/log/mvt/*.log", "log_group_name": "$group",
     "log_stream_name": "{instance_id}/liftproof", "retention_in_days": -1}
  ]}}}
}
JSON
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
