<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Liftproof validation report · {{ r.project }} · {{ r.run_id }}</title>
<style>
  :root { --fg:#1b1d22; --muted:#5d6470; --bg:#fff; --panel:#f5f6f8; --line:#e2e5ea;
          --ok:#1d7a46; --warn:#9a6300; --bad:#b3261e; --accent:#5b3cc4; }
  * { box-sizing: border-box; }
  body { margin:0; font:14px/1.5 -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
         color:var(--fg); background:var(--bg); }
  main { max-width: 1080px; margin: 0 auto; padding: 32px 20px 64px; }
  h1 { font-size: 13px; letter-spacing:.08em; text-transform: uppercase; color: var(--muted);
       margin: 0 0 6px; font-weight:600; }
  h2 { font-size: 18px; margin: 36px 0 12px; }
  .verdict { font-size: 34px; font-weight: 700; margin: 0 0 4px; }
  .passed { color: var(--ok); } .passed_with_differences { color: var(--warn); }
  .failed { color: var(--bad); }
  .sub { color: var(--muted); }
  .classification { display:inline-block; margin-top:10px; padding:3px 10px; border-radius:99px;
                    background:var(--panel); border:1px solid var(--line); font-size:12px; }
  .tiles { display:grid; grid-template-columns: repeat(auto-fit, minmax(150px,1fr)); gap:12px; }
  .tile { background:var(--panel); border-radius:10px; padding:14px 16px; }
  .tile b { display:block; font-size:24px; }
  .tile span { color:var(--muted); font-size:12px; }
  table { width:100%; border-collapse: collapse; font-size:13px; }
  th, td { text-align:left; padding:7px 8px; border-bottom:1px solid var(--line); vertical-align: top; }
  th { color:var(--muted); font-weight:600; font-size:12px; }
  td.num { text-align:right; font-variant-numeric: tabular-nums; }
  .sev { display:inline-block; min-width:22px; text-align:center; border-radius:4px; color:#fff;
         font-weight:700; font-size:11px; padding:1px 4px; }
  .s5,.s4 { background:var(--bad); } .s3 { background:#c4540a; } .s2 { background:var(--warn); }
  .s1 { background:#7b8190; }
  .status-matched { color:var(--ok); } .status-different { color:var(--bad); }
  .status-not_checked, .status-excluded { color:var(--warn); }
  code { font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .scroll { overflow-x:auto; }
  dl { display:grid; grid-template-columns: max-content 1fr; gap:4px 16px; margin:0; }
  dt { color:var(--muted); }
  footer { margin-top:40px; color:var(--muted); font-size:12px; }
</style>
</head>
<body>
<main>
  <h1>Liftproof validation report · {{ r.project }}</h1>
  <p class="verdict {{ r.verdict }}">{{ {"passed":"Passed","passed_with_differences":"Passed with differences","failed":"Failed"}[r.verdict] }}</p>
  <div class="sub">Run {{ r.run_id }} · {{ r.mode }} · {{ r.run.started_at }} to {{ r.run.finished_at }}</div>
  {% if r.failure %}<p class="failed"><strong>The run did not complete:</strong> {{ r.failure }}</p>{% endif %}
  <div class="classification">Classification: {{ r.classification }}</div>

  <h2>Counts</h2>
  <div class="tiles">
    <div class="tile"><b>{{ r.counts.tables|num }}</b><span>tables in scope</span></div>
    <div class="tile"><b>{{ r.counts.tables_matched|num }}</b><span>tables matched</span></div>
    <div class="tile"><b>{{ r.counts.tables_different|num }}</b><span>tables with differences</span></div>
    <div class="tile"><b>{{ r.counts.differences|num }}</b><span>differences</span></div>
    <div class="tile"><b>{{ r.counts.not_checked|num }}</b><span>items not checked</span></div>
  </div>

  <h2>Coverage</h2>
  <div class="tiles">
    <div class="tile"><b>{{ r.coverage.tables_coverage_pct|pct }}</b><span>coverage: tables compared of tables in scope</span></div>
    <div class="tile"><b>{{ r.coverage.tables_success_pct|pct }}</b><span>success rate: tables matched of tables compared</span></div>
  </div>
  {% if r.coverage.not_covered %}
  <p><strong>Not covered</strong></p>
  <table><tr><th>Object</th><th>Reason</th></tr>
  {% for n in r.coverage.not_covered %}<tr><td>{{ n.object }}</td><td>{{ n.reason }}</td></tr>{% endfor %}
  </table>{% endif %}
  {% if r.coverage.partially_compared %}
  <p><strong>Compared on a subset of columns</strong></p>
  <table><tr><th>Table</th><th>Columns not compared</th></tr>
  {% for p in r.coverage.partially_compared %}<tr><td>{{ p.object }}</td><td>{{ p.excluded_columns|join(", ") }}</td></tr>{% endfor %}
  </table>{% endif %}
  {% if r.coverage.exclusions %}
  <p><strong>Exclusions and their reasons</strong></p>
  <table><tr><th>Object</th><th>Column</th><th>Reason</th></tr>
  {% for e in r.coverage.exclusions %}<tr><td>{{ e.object }}</td><td>{{ e.column or "whole table" }}</td><td>{{ e.reason }}</td></tr>{% endfor %}
  </table>{% endif %}

  <h2>Differences</h2>
  {% set diffs = r.findings | selectattr("kind", "in", ["difference", "error", "not_checked", "partial"]) | list %}
  {% if diffs %}
  <div class="scroll"><table>
    <tr><th>Sev</th><th>Where</th><th>What</th><th>Source</th><th>Target</th></tr>
    {% for f in diffs %}
    <tr>
      <td><span class="sev s{{ f.severity }}">{{ f.severity }}</span></td>
      <td><code>{{ f.object }}{% if f.column %}.{{ f.column }}{% endif %}</code>{% if f.locator %}<br><span class="sub">{{ f.locator }}</span>{% endif %}</td>
      <td>{{ f.summary }}{% if f.kind != "difference" %} <span class="sub">({{ f.kind|replace("_"," ") }})</span>{% endif %}</td>
      <td><code>{{ f.expected if f.expected is not none else "" }}</code></td>
      <td><code>{{ f.actual if f.actual is not none else "" }}</code></td>
    </tr>
    {% endfor %}
  </table></div>
  {% else %}<p>No differences found.</p>{% endif %}

  {% if r.tables %}
  <h2>Tables</h2>
  <div class="scroll"><table>
    <tr><th>Table</th><th>Status</th><th class="num">Source rows</th><th class="num">Target rows</th><th class="num">Missing</th><th class="num">Only in target</th><th class="num">Changed</th><th>Key</th></tr>
    {% for t in r.tables %}
    <tr><td><code>{{ t.table }}</code>{% if t.partial %} <span class="sub">(partial)</span>{% endif %}</td>
      <td class="status-{{ t.status }}">{{ t.status|replace("_"," ") }}</td>
      <td class="num">{{ t.source_rows|num }}</td><td class="num">{{ t.target_rows|num }}</td>
      <td class="num">{{ t.missing_rows|num }}</td><td class="num">{{ t.extra_rows|num }}</td>
      <td class="num">{{ t.changed_rows|num }}</td><td>{{ t.key }}</td></tr>
    {% endfor %}
  </table></div>
  {% endif %}

  {% if r.traceability %}
  <h2>Traceability</h2>
  <table><tr><th>User story</th><th class="num">Test cases run</th><th class="num">Differences raised</th></tr>
  {% for s in r.traceability %}<tr><td>{{ s.story }}</td><td class="num">{{ s.tests }}</td><td class="num">{{ s.differences }}</td></tr>{% endfor %}
  </table>{% endif %}

  <h2>Range of this run</h2>
  <dl>
    {% for k, v in r.range.items() %}<dt>{{ k|replace("_"," ") }}</dt><dd><code>{{ v if v is string else (v|tojson_pretty) }}</code></dd>{% endfor %}
  </dl>

  <h2>Run metadata</h2>
  <dl>
    {% for k, v in r.run.items() %}<dt>{{ k|replace("_"," ") }}</dt><dd><code>{{ v if v is string else (v|tojson_pretty) }}</code></dd>{% endfor %}
  </dl>

  <footer>Generated by Liftproof {{ r.run.product_version }} at {{ generated }} · report schema {{ r.schema_version }} · the JSON report beside this file carries every finding shown here.</footer>
</main>
</body>
</html>
